import { DEFAULT_BANDS, figureShapes, headRadius, paintCel, type CelBand, type HeadParts } from './draw'
import { CATCHLIGHT, EYE_BASE_W, FACES, IRIS, PUPIL, SCLERA } from './faces'
import type { FigurePlan } from './figures'
import { INK, SKIN, css, materials, shade, tint, type Materials } from './palette'
import { FIG_W, GROUND, applyBuild, limbPath, ovalPath, polyPath, type Pt, type Skeleton } from './rig'

/**
 * The portrait's own head.
 *
 * Six rounds of face work went into `drawDetails`/`drawPortraitDetail` by
 * ADDING marks - a second eye, a nostril, a catchlight, a lower lip, a curved
 * brow - on top of a head that could not carry them. Measured on the rendered
 * pixels, the art before this module scored:
 *
 *   forehead skin above the brow   weiyan 0.0%, zhaoyun 1.1%   (face on the hat)
 *   near-eye sclera width:height   0.92 .. 1.24                (a disc)
 *   near cheek / far temple luma   0.71 .. 0.75                (face in shadow)
 *   head half-width, mouth / eye   0.887 .. 0.897              (a bare ellipse,
 *                                                               closed form 0.889)
 *
 * None of those is a missing mark. They are the head being an ellipse, the
 * headgear reaching BELOW the eyes, and the cel terminator putting the whole
 * face on the dark side. So the portrait gets its own head, headgear, hair and
 * light, run through the same `paintCel` as everything else - which is what
 * keeps it the same art style - while the FIGHTER's head is untouched and every
 * sprite gate stays exactly where it was.
 *
 * It still derives from the same `FigurePlan` - build, three colours, headgear
 * kind, beard, face kind - so a portrait still cannot disagree with the
 * character it labels. That was ART-3's argument for `drawPortraitDetail` and
 * it holds here.
 */

/**
 * Head half-width, as a fraction of headR.
 *
 * The sprite head is a circle-ish ellipse: rx = R, ry = 1.14R, so height:width
 * is 1.14 - an egg. A human head is about 1.35-1.45. 0.80 with the outline
 * below gives 1.47: at the lean end of the human range, which is where the
 * owner asked for it after the first frontal render read as wide and round.
 */
const HW = 0.8

/** The head half-width, exported so the gates locate features from the
 * layout rather than from a copy of these numbers. */
export const PORTRAIT_HW = HW

/**
 * Where everything sits, as fractions of headR from the head centre.
 *
 * The old layout put the eye line at +0.20R - 58% of the way down the head, and
 * 63% once the headgear was counted - which is why the features looked crowded
 * into the bottom of the face. Standard head canon puts the eye line near the
 * middle.
 */
const L = {
  /** Lowest point of the headgear over the face. */
  gearEdge: -0.68,
  /** Hair reaches lower than the gear brim but is wider, so it shows at the
   * temples and leaves the middle of the forehead clear. It is also the top of
   * the FACE REGION that the face pass repaints. */
  hairEdge: -0.56,
  browY: -0.28,
  /** The eye line, at the vertical midpoint between crown and chin - which is
   * where head canon puts it, and where the old layout did not. */
  eyeY: 0.0,
  /** Eye centres, MIRRORED about the centre line. A head two HW wide is five
   * eye-widths across, so 0.40 centres put one eye-width between them. */
  eyeX: 0.4,
  noseBase: 0.34,
  mouthY: 0.62,
  mouthHalfW: 0.27,
  earX: 0.99,
  earY: 0.1,
} as const

/** The eye line, in headR units below the head centre. Exported because the
 * framing gate locates the head from the rendered eyes. */
export const PORTRAIT_EYE_Y = L.eyeY

/** Eye centres, in HW units either side of the centre line. */
export const PORTRAIT_EYE_X = L.eyeX

/** The mouth line and the brow line, in headR units. */
export const PORTRAIT_MOUTH_Y = L.mouthY
export const PORTRAIT_BROW_Y = L.browY

/**
 * The portrait's light.
 *
 * The sprite bands put the terminator at x ~ 53.8 while a head spans 38.6..59.4
 * and the figure faces RIGHT, so every feature landed on the dark side and the
 * lit band (x < 38.7) never reached the head at all. Measured: the near cheek
 * came out 25-29% darker than the back of the skull on all five heroes. You
 * cannot read form that is uniformly in shadow.
 *
 * A portrait is lit from the side the subject faces. Shadow falls on the far
 * side of the head, light on the face.
 */
export const PORTRAIT_BANDS: readonly CelBand[] = [
  { split: [0.464, 0.354], toward: -1, fill: DEFAULT_BANDS[0]?.fill ?? 'rgba(22, 14, 30, 0.34)' },
  { split: [0.541, 0.458], toward: 1, fill: DEFAULT_BANDS[1]?.fill ?? 'rgba(255, 246, 228, 0.17)' },
]

/**
 * How far above the head centre each headgear reaches, and how thick its bowl
 * is, in headR units.
 *
 * Named because two things need them: the drawing below, and
 * `portraitHeadTop`, which the framing gate uses to prove the whole head fits
 * the frame. A test-side copy of these numbers is exactly the drift that let
 * ART-5 ship, so there is one table and both read it.
 */
const HAIR_TOP = -1.3
const GEAR: Record<string, { thickness: number; top: number }> = {
  helmet: { thickness: 0.1, top: -1.36 }, // top = the crest tip
  turban: { thickness: 0.22, top: -1.35 }, // top = the knot
  crown: { thickness: 0.08, top: -1.42 }, // top = the zigzag peaks
  band: { thickness: 0, top: -1.1 },
  hood: { thickness: 0, top: -1.24 },
}

/** The topmost point of the head, its hair and its headgear, in headR units. */
export function portraitHeadTop(headgear: string): number {
  const g = GEAR[headgear]
  const crown = Math.min(...HEAD_OUTLINE.map(([, y]) => y))
  if (!g) return Math.min(crown, HAIR_TOP)
  return Math.min(crown, HAIR_TOP, crown - g.thickness * 0.55, g.top)
}

/**
 * The head, as NAMED landmarks of its right side.
 *
 * Frontal and symmetric. The 3/4 outline this replaces put both eyes in the
 * right half of the head, left the other half as empty skull, and carried the
 * nose as a point on the SILHOUETTE reaching 1.16 HW against a head half-width
 * of 1.02 - which is what read as a beak. Six of its seventeen points existed
 * only to describe that profile (nasion, nose tip, nose base, upper lip, lip,
 * mentolabial sulcus) and are gone: a frontal nose is structure INSIDE the
 * face, not a bump on its edge.
 *
 * Named rather than positional because `capPoints` used to index this array by
 * hard-coded integers - o(0), o(2), o(15), o(16). Adding or removing a point
 * renumbered it and the headgear silently traced the wrong skull.
 */
const SKULL = {
  crown: [0.0, -1.14],
  upperTemple: [0.56, -0.97],
  temple: [0.9, -0.62],
  cheekbone: [0.98, -0.04], // the widest point of a human head
  cheek: [0.88, 0.34],
  jawAngle: [0.68, 0.66],
  jaw: [0.4, 0.98],
  chin: [0.0, 1.16],
} as const satisfies Record<string, readonly [number, number]>

const mirrored = ([x, y]: readonly [number, number]): [number, number] => [-x, y]

/** The closed outline: down the right side, then back up the mirrored left. */
const HEAD_OUTLINE: ReadonlyArray<readonly [number, number]> = [
  SKULL.crown,
  SKULL.upperTemple,
  SKULL.temple,
  SKULL.cheekbone,
  SKULL.cheek,
  SKULL.jawAngle,
  SKULL.jaw,
  SKULL.chin,
  mirrored(SKULL.jaw),
  mirrored(SKULL.jawAngle),
  mirrored(SKULL.cheek),
  mirrored(SKULL.cheekbone),
  mirrored(SKULL.temple),
  mirrored(SKULL.upperTemple),
]

/**
 * A smooth closed path through the points, Catmull-Rom converted to cubics.
 *
 * TRACE ONLY, like every helper in `rig.ts` - it calls `beginPath` and
 * `closePath` and never fills. That contract is what produced the ART-5 bug, a
 * traced brow nobody painted, so every call site here fills and a gate pins it.
 */
function smoothClosedPath(ctx: CanvasRenderingContext2D, pts: readonly Pt[]): void {
  const n = pts.length
  const at = (i: number): Pt => pts[((i % n) + n) % n] as Pt
  ctx.beginPath()
  const first = at(0)
  ctx.moveTo(first.x, first.y)
  for (let i = 0; i < n; i += 1) {
    const p0 = at(i - 1)
    const p1 = at(i)
    const p2 = at(i + 1)
    const p3 = at(i + 2)
    ctx.bezierCurveTo(
      p1.x + (p2.x - p0.x) / 6,
      p1.y + (p2.y - p0.y) / 6,
      p2.x - (p3.x - p1.x) / 6,
      p2.y - (p3.y - p1.y) / 6,
      p2.x,
      p2.y,
    )
  }
  ctx.closePath()
}

/** Head-local (x in HW units, y in headR units) to figure space. */
function headPt(head: Pt, headR: number, rot: number, lx: number, ly: number): Pt {
  const x = lx * HW * headR
  const y = ly * headR
  if (!rot) return { x: head.x + x, y: head.y + y }
  const cos = Math.cos(rot)
  const sin = Math.sin(rot)
  return { x: head.x + x * cos - y * sin, y: head.y + x * sin + y * cos }
}

function portraitHeadPath(ctx: CanvasRenderingContext2D, head: Pt, headR: number, rot: number): void {
  smoothClosedPath(
    ctx,
    HEAD_OUTLINE.map(([lx, ly]) => headPt(head, headR, rot, lx, ly)),
  )
}

/**
 * The outline of the skull ABOVE the brim, pushed outward by `thickness`.
 *
 * Headgear was an ellipse whose widest point sat at its own mid-height - which
 * on a skull that has already tapered toward the crown reads as a sombrero
 * balanced on the head. Deriving the cap from `HEAD_OUTLINE` instead means a
 * helmet, a turban and a cap are all "the top of this head, thickened", so they
 * sit ON it however the head is shaped.
 */
function capPoints(thickness: number): Array<[number, number]> {
  const brim = L.gearEdge
  // The right-hand chain, crown to chin. Searched for the segment that
  // BRACKETS the brim rather than assuming one: the brim has moved up the
  // skull twice now, and a hard-coded pair silently extrapolates when it does.
  const chain: ReadonlyArray<readonly [number, number]> = [
    SKULL.crown,
    SKULL.upperTemple,
    SKULL.temple,
    SKULL.cheekbone,
    SKULL.cheek,
    SKULL.jawAngle,
    SKULL.jaw,
    SKULL.chin,
  ]
  let right: [number, number] = [SKULL.temple[0], brim]
  for (let i = 0; i < chain.length - 1; i += 1) {
    const a = chain[i] as readonly [number, number]
    const b = chain[i + 1] as readonly [number, number]
    if ((a[1] - brim) * (b[1] - brim) > 0) continue
    const t = (brim - a[1]) / (b[1] - a[1])
    right = [a[0] + (b[0] - a[0]) * t, brim]
    break
  }
  const upper = chain.filter(([, y]) => y < brim && y > SKULL.crown[1])
  const skull: Array<readonly [number, number]> = [
    right,
    ...[...upper].reverse(),
    SKULL.crown,
    ...upper.map(mirrored),
    mirrored(right),
  ]
  return skull.map(([x, y], i) => {
    const onBrim = i === 0 || i === skull.length - 1
    // Push out from the centre line; lift the crown, but leave the brim where
    // it is so the forehead the raised gear bought is not spent again.
    return [x * (1 + thickness), onBrim ? y : y - thickness * 0.55]
  })
}

function capPath(
  ctx: CanvasRenderingContext2D,
  at: (lx: number, ly: number) => Pt,
  thickness: number,
): void {
  smoothClosedPath(
    ctx,
    capPoints(thickness).map(([x, y]) => at(x, y)),
  )
}

/**
 * A beard with a jawline.
 *
 * The first attempt closed the shape with a straight chord between the two
 * sideburns, which put a flat horizontal edge across the face and read as a
 * BIB rather than a beard. A beard's upper boundary runs from one sideburn,
 * dips below the mouth, and rises to the other - so the mouth stays visible
 * above it and the chin is covered.
 *
 * Painted in the face pass rather than as a shape, because `figureShapes`
 * draws the pauldron, arm and weapon after the head: as a shape, Guan Yu's
 * 美髯 came out behind his own glaive.
 */
function portraitBeard(
  ctx: CanvasRenderingContext2D,
  plan: FigurePlan,
  headR: number,
  m: Materials,
): void {
  const p = (lx: number, ly: number): Pt => ({ x: lx * HW * headR, y: ly * headR })
  const paint = (pts: ReadonlyArray<readonly [number, number]>, fill: string): void => {
    smoothClosedPath(ctx, pts.map(([lx, ly]) => p(lx, ly)))
    ctx.lineWidth = headR * 0.07
    ctx.strokeStyle = INK
    ctx.lineJoin = 'round'
    ctx.stroke()
    ctx.fillStyle = fill
    ctx.fill()
  }

  // 美髯 - Guan Yu is named for this beard, so a `long` one still runs off the
  // bottom of the frame. Narrower than the first frontal pass, which filled
  // the bottom half of the portrait and read as a dark mass rather than as a
  // beard: the sideburns come in and the jaw is left showing.
  const long = plan.beard === 'long'
  // Both run off the bottom of the frame. A beard that ENDS inside it stops
  // in a flat horizontal line and reads as a bib rather than as hair - which
  // is what the first pass did, worst of all on Huang Zhong's white one.
  const drop = long ? 2.3 : 1.9
  const hang = long ? 0.4 : 0.48
  paint(
    [
      [-0.72, 0.3], // sideburn
      [-0.5, 0.74],
      [0.0, 0.92], // clear of the lower lip at 0.78
      [0.5, 0.74],
      [0.72, 0.3], // sideburn
      [0.72, 0.66],
      [0.6, 1.04],
      [hang + 0.12, 1.52],
      [hang, drop - 0.4],
      [0.0, drop],
      [-hang, drop - 0.4],
      [-hang - 0.12, 1.52],
      [-0.6, 1.04],
      [-0.72, 0.66],
    ],
    m.hair,
  )

  if (long) {
    // A flowing beard parts down the middle; a bristling one does not.
    ctx.fillStyle = css(tint(plan.beardColor ?? 0x3a2a18, 0.16))
    limbPath(ctx, p(0, 1.05), p(0, drop - 0.35), headR * 0.05, headR * 0.03)
    ctx.fill()
  } else {
    ctx.fillStyle = css(shade(plan.beardColor ?? 0x3a2a18, 0.3))
    for (const side of [1, -1]) {
      limbPath(ctx, p(side * 0.4, 1.0), p(side * 0.5, drop - 0.3), headR * 0.09, headR * 0.05)
      ctx.fill()
    }
  }

  // 虎须 - the moustache, mirrored. Sits ON the upper lip: drawn across the
  // mouth it hides the one feature three of five heroes were missing.
  ctx.fillStyle = m.hair
  for (const side of [1, -1]) {
    limbPath(ctx, p(side * 0.04, 0.5), p(side * 0.36, 0.56), headR * 0.07, headR * 0.05)
    ctx.fill()
  }
}

/**
 * Head, hair, headgear and beard as the PORTRAIT wears them.
 *
 * Every gear kind is raised so its lowest point over the face is `L.gearEdge`,
 * while its silhouette top stays within a few hundredths of where the sprite
 * puts it - so Zhao Yun still reads as the one in the crested helmet and Wei
 * Yan as the one in the turban. What changes is that the brim now sits above
 * the brow instead of across the eyes.
 */
const portraitHeadParts: HeadParts = (add, plan, p, m, headR) => {
  const head = p.head
  const rot = p.headRot
  const at = (lx: number, ly: number): Pt => headPt(head, headR, rot, lx, ly)

  add((c) => portraitHeadPath(c, head, headR, rot), m.skin)

  // Hair, under the gear, showing as a band between brim and forehead. Every
  // kind gets it here: on the sprite, `hood` and `helmet` get no hair shape at
  // all, which is why Guan Yu and Zhao Yun had nothing framing the face.
  const hairTop = HAIR_TOP
  add(
    (c) =>
      ovalPath(
        c,
        at(-0.05, (L.hairEdge + hairTop) / 2),
        headR * HW * 1.12,
        headR * ((L.hairEdge - hairTop) / 2),
        rot,
      ),
    m.hair,
  )

  const CREST_TIP = GEAR.helmet?.top ?? -1.36
  const KNOT_R = 0.19
  switch (plan.headgear) {
    case 'helmet':
      add((c) => capPath(c, at, GEAR.helmet?.thickness ?? 0.1), m.gear)
      add(
        (c) => polyPath(c, [at(-0.22, -1.24), at(0.22, -1.26), at(0.12, CREST_TIP), at(-0.2, CREST_TIP + 0.02)]),
        m.trim,
      )
      break
    case 'turban':
      add((c) => capPath(c, at, GEAR.turban?.thickness ?? 0.22), m.gear)
      add(
        (c) => ovalPath(c, at(0.66, (GEAR.turban?.top ?? -1.35) + KNOT_R), headR * HW * 0.32, headR * KNOT_R, 0.35),
        m.trim,
      )
      break
    case 'crown':
      add((c) => capPath(c, at, GEAR.crown?.thickness ?? 0.08), m.gear)
      add(
        (c) =>
          polyPath(c, [
            at(-0.98, -1.06),
            at(-0.54, GEAR.crown?.top ?? -1.42),
            at(-0.06, -1.12),
            at(0.42, GEAR.crown?.top ?? -1.42),
            at(0.88, -1.02),
          ]),
        m.trim,
      )
      break
    case 'band':
      add(
        (c) => polyPath(c, [at(-1.06, -1.04), at(1.04, -1.1), at(1.0, -0.56), at(-1.02, -0.5)]),
        m.gear,
      )
      add(
        (c) => polyPath(c, [at(-0.98, -0.96), at(-1.95, -0.3), at(-1.72, 0.1), at(-0.95, -0.52)]),
        m.trim,
      )
      break
    case 'hood':
      // A hood is the cap plus a drape that falls behind the jaw.
      add(
        (c) =>
          smoothClosedPath(c, [
            at(1.06, -0.6),
            at(1.2, -0.9),
            at(0.5, GEAR.hood?.top ?? -1.24),
            at(-0.5, GEAR.hood?.top ?? -1.24),
            at(-1.2, -0.9),
            at(-1.34, 0.3),
            at(-1.2, 1.15),
            at(-0.62, 0.74),
            at(-0.96, -0.24),
            at(-0.62, -0.6),
            at(0.62, -0.6),
            at(0.96, -0.24),
            at(0.62, 0.74),
            at(1.2, 1.15),
            at(1.34, 0.3),
          ]),
        m.gear,
      )
      break
  }
}

/** An almond eye aperture, traced only. Authored for the RIGHT eye. */
function aperturePath(ctx: CanvasRenderingContext2D, w: number, h: number): void {
  const hw = w / 2
  const hh = h / 2
  // Inner corner (toward the nose) sits a little lower than the outer one, as
  // it does on a face. The left eye gets this MIRRORED rather than copied -
  // applied with one sign, as it used to be, a frontal face grows two right eyes.
  const inner = { x: -hw, y: hh * 0.12 }
  const outer = { x: hw, y: -hh * 0.08 }
  ctx.beginPath()
  ctx.moveTo(outer.x, outer.y)
  ctx.quadraticCurveTo(0, -hh * 2.1, inner.x, inner.y)
  ctx.quadraticCurveTo(0, hh * 1.5, outer.x, outer.y)
  ctx.closePath()
}

/**
 * One eye. `side` is +1 for the viewer's right, -1 for the left.
 *
 * Drawn as the right eye and MIRRORED by the transform, so the aperture's
 * inner corner, the lash line and `eyeTilt` all flip together. The catchlight
 * is counter-mirrored so both eyes catch the same light rather than each
 * catching its own.
 */
function portraitEye(
  ctx: CanvasRenderingContext2D,
  c: Pt,
  w: number,
  aspect: number,
  tilt: number,
  side: 1 | -1,
): void {
  const h = w / aspect
  ctx.save()
  ctx.translate(c.x, c.y)
  ctx.scale(side, 1)
  ctx.rotate(tilt)

  ctx.fillStyle = SCLERA
  aperturePath(ctx, w, h)
  ctx.fill()

  ctx.save()
  aperturePath(ctx, w, h)
  ctx.clip()
  // Iris a little taller than the aperture and sat low, so the upper lid takes
  // more of it than the lower one - which is what a relaxed eye does.
  const ir = h * 0.62
  ctx.fillStyle = IRIS
  ovalPath(ctx, { x: 0, y: h * 0.1 }, ir, ir, 0)
  ctx.fill()
  ctx.fillStyle = PUPIL
  ovalPath(ctx, { x: 0, y: h * 0.1 }, ir * 0.42, ir * 0.42, 0)
  ctx.fill()
  // x multiplied by `side` INSIDE an already-mirrored frame, so both
  // catchlights land on the same side of the face.
  ctx.fillStyle = CATCHLIGHT
  ovalPath(ctx, { x: side * -ir * 0.36, y: h * 0.1 - ir * 0.38 }, ir * 0.26, ir * 0.26, 0)
  ctx.fill()
  ctx.restore()

  // Lash line along the upper lid. The mark that most makes an eye read as an
  // eye, and the coarse face has never had one.
  ctx.strokeStyle = INK
  ctx.lineWidth = h * 0.3
  ctx.lineCap = 'round'
  ctx.beginPath()
  ctx.moveTo(w / 2, -(h / 2) * 0.08)
  ctx.quadraticCurveTo(0, -(h / 2) * 2.1, -w / 2, (h / 2) * 0.12)
  ctx.stroke()
  ctx.restore()
}

/** The head outline in HEAD-LOCAL coordinates, for clipping. */
function headLocalPath(ctx: CanvasRenderingContext2D, headR: number): void {
  smoothClosedPath(
    ctx,
    HEAD_OUTLINE.map(([lx, ly]) => ({ x: lx * HW * headR, y: ly * headR })),
  )
}

/**
 * Skin shading, in one of three treatments.
 *
 * Runs inside a clip of (skull, below the hairline) and repaints that region
 * in base skin first. That is what removes the cel band's seam:
 * `PORTRAIT_BANDS`' light edge crosses the head at head-local x = +0.09 headR,
 * within a tenth of a radius of dead centre, so on a frontal face it runs
 * straight down the glabella, nose, philtrum and chin. It still lights the
 * hair and headgear above, where a hard edge reads as light on a helmet rather
 * than as a seam on a face.
 */
function paintSkin(
  ctx: CanvasRenderingContext2D,
  headR: number,
  skin: number,
  q: (lx: number, ly: number) => Pt,
): void {
  const R = headR
  const box = { x: -1.4 * HW * R, y: L.hairEdge * R, w: 2.8 * HW * R, h: 2.2 * R }
  const fillAll = (v: string | CanvasGradient, alpha = 1): void => {
    ctx.save()
    ctx.globalAlpha = alpha
    ctx.fillStyle = v
    ctx.fillRect(box.x, box.y, box.w, box.h)
    ctx.restore()
  }

  // Form carried by light rather than by marks: one warm core over brow and
  // nose, falling off to a cooler edge at the temples and jaw.
  const core = q(0, -0.08)
  const g = ctx.createRadialGradient(core.x, core.y, 0.08 * R, core.x, core.y, 1.35 * R)
  g.addColorStop(0, css(tint(skin, 0.17)))
  g.addColorStop(0.5, css(skin))
  g.addColorStop(1, css(shade(skin, 0.32)))
  fillAll(g)

  // EVERY fade below ends in a transparent copy of its OWN colour, never in
  // 'rgba(0,0,0,0)'. Canvas interpolates gradient stops unpremultiplied, so a
  // stop at transparent BLACK drags the colour toward black as the alpha
  // falls: halfway out, the bridge HIGHLIGHT was a translucent grey-brown
  // ring. That ring - round both eyes, between them and down the nose - was
  // the grey smudge on every portrait in the cast, and it read as dirt.
  const jaw = ctx.createLinearGradient(0, 0.4 * R, 0, 1.16 * R)
  jaw.addColorStop(0, clear(shade(skin, 0.36)))
  jaw.addColorStop(1, css(shade(skin, 0.36)))
  fillAll(jaw, 0.6)

  // The eye socket: shadow under the brow ridge, faint and off the eye
  // itself, where a disc centred ON the eye read as a bruise.
  for (const side of [1, -1]) {
    const e = q(side * L.eyeX, L.eyeY - 0.12)
    const soc = ctx.createRadialGradient(e.x, e.y, 0.02 * R, e.x, e.y, 0.3 * R)
    soc.addColorStop(0, css(shade(skin, 0.2)))
    soc.addColorStop(1, clear(shade(skin, 0.2)))
    fillAll(soc, 0.35)
  }

  const bridge = q(0, 0.1)
  const br = ctx.createRadialGradient(bridge.x, bridge.y, 0.01 * R, bridge.x, bridge.y, 0.32 * R)
  br.addColorStop(0, css(tint(skin, 0.22)))
  br.addColorStop(1, clear(tint(skin, 0.22)))
  fillAll(br, 0.7)
}

/** A packed RGB at zero alpha: the end stop for a fade OF that colour. */
function clear(rgb: number): string {
  return `rgba(${(rgb >> 16) & 255}, ${(rgb >> 8) & 255}, ${rgb & 255}, 0)`
}

/**
 * The face, frontal and symmetric.
 *
 * Everything two-sided is MIRRORED rather than copied. The pass this replaces
 * applied `aperturePath`, the lash line, `eyeTilt` and `browAngle` with the
 * same sign to both sides - invisible on a 3/4 face, but on a frontal one that
 * is two right eyes and a single raised brow.
 */
function drawPortraitFace(
  ctx: CanvasRenderingContext2D,
  plan: FigurePlan,
  p: Skeleton,
  m: Materials,
  headR: number,
): void {
  const face = FACES[plan.face ?? 'plain']
  const skin = plan.skin ?? SKIN
  const lipLight = css(tint(skin, 0.2))

  ctx.save()
  ctx.translate(p.head.x, p.head.y)
  ctx.rotate(p.headRot)
  const q = (lx: number, ly: number): Pt => ({ x: lx * HW * headR, y: ly * headR })

  // The face region: the skull, below the hairline. Two successive clips
  // INTERSECT, which is exactly what is wanted and avoids hand-building the
  // intersection as a path that could bow into the hair.
  ctx.save()
  headLocalPath(ctx, headR)
  ctx.clip()
  ctx.beginPath()
  ctx.rect(-2 * HW * headR, L.hairEdge * headR, 4 * HW * headR, 3 * headR)
  ctx.clip()

  paintSkin(ctx, headR, skin, q)


  // --- nose: wings and nostrils, INSIDE the face. The 3/4 head carried the
  // nose as a point on the SILHOUETTE, which is what read as a beak.
  ctx.fillStyle = css(shade(skin, 0.16))
  for (const side of [1, -1]) {
    smoothClosedPath(ctx, [
      q(side * 0.06, L.noseBase - 0.28),
      q(side * 0.23, L.noseBase - 0.04),
      q(side * 0.2, L.noseBase + 0.07),
      q(side * 0.04, L.noseBase + 0.02),
    ])
    ctx.fill()
  }
  ctx.fillStyle = css(shade(skin, 0.5))
  for (const side of [1, -1]) {
    ovalPath(ctx, q(side * 0.11, L.noseBase + 0.02), headR * 0.045, headR * 0.03, side * 0.3)
    ctx.fill()
  }

  // --- mouth, centred and ALWAYS visible. Three of five heroes had none: the
  // beard swallowed it.
  const mw = L.mouthHalfW
  ctx.fillStyle = css(shade(skin, 0.24))
  smoothClosedPath(ctx, [
    q(-mw, L.mouthY - 0.02),
    q(-0.1, L.mouthY - 0.1),
    q(0, L.mouthY - 0.05),
    q(0.1, L.mouthY - 0.1),
    q(mw, L.mouthY - 0.02),
    q(0, L.mouthY + 0.02),
  ])
  ctx.fill()
  ctx.strokeStyle = INK
  ctx.lineWidth = headR * 0.05
  ctx.lineCap = 'round'
  ctx.beginPath()
  ctx.moveTo(q(-mw, L.mouthY).x, q(-mw, L.mouthY).y)
  ctx.quadraticCurveTo(0, q(0, L.mouthY + 0.06).y, q(mw, L.mouthY).x, q(mw, L.mouthY).y)
  ctx.stroke()
  ctx.fillStyle = lipLight
  smoothClosedPath(ctx, [
    q(-mw * 0.86, L.mouthY + 0.04),
    q(0, L.mouthY + 0.06),
    q(mw * 0.86, L.mouthY + 0.04),
    q(0, L.mouthY + 0.16),
  ])
  ctx.fill()

  // --- brows, mirrored. `browAngle` is negated on the left so the pair reads
  // as a pair; applied with one sign it reads as one brow raised.
  ctx.fillStyle = m.hair
  for (const side of [1, -1] as const) {
    const len = HW * headR * 0.5 * face.browLength
    const midX = side * HW * headR * (L.eyeX + 0.02)
    const midY = L.browY * headR
    const angle = side * face.browAngle
    const ex = ((len / 2) * Math.cos(angle)) * side
    const ey = (len / 2) * Math.sin(angle) * side
    const lift = len * face.browArch
    const w = headR * 0.115 * face.browWeight
    ctx.beginPath()
    ctx.moveTo(midX - ex, midY - ey + w / 2)
    ctx.quadraticCurveTo(midX, midY - lift - w / 2, midX + ex, midY + ey + w * 0.2)
    ctx.quadraticCurveTo(midX, midY - lift + w / 2, midX - ex, midY - ey + w / 2)
    ctx.closePath()
    ctx.fill()
  }

  // --- eyes
  const eyeW = HW * headR * EYE_BASE_W * face.eyeW
  if (plan.missingEye) {
    // Xiahou Dun keeps the good eye: losing one says nothing about the other.
    portraitEye(ctx, q(-L.eyeX, L.eyeY), eyeW, face.eyeAspect, face.eyeTilt, -1)
    ctx.fillStyle = m.eye
    ovalPath(ctx, q(L.eyeX, L.eyeY), eyeW * 0.5, eyeW * 0.32, 0)
    ctx.fill()
    ctx.fillStyle = INK
    ovalPath(ctx, q(L.eyeX, L.eyeY + 0.02), eyeW * 0.3, eyeW * 0.18, 0)
    ctx.fill()
    ctx.fillStyle = css(tint(skin, 0.35))
    limbPath(ctx, q(L.eyeX + 0.3, L.browY), q(L.eyeX - 0.2, L.eyeY + 0.5), headR * 0.07, headR * 0.055)
    ctx.fill()
  } else {
    portraitEye(ctx, q(-L.eyeX, L.eyeY), eyeW, face.eyeAspect, face.eyeTilt, -1)
    portraitEye(ctx, q(L.eyeX, L.eyeY), eyeW, face.eyeAspect, face.eyeTilt, 1)
  }

  // --- age, for the old general only. Two marks: a grid of wrinkles at this
  // size reads as damage rather than as age.
  if (plan.face === 'aged') {
    ctx.strokeStyle = css(shade(skin, 0.3))
    ctx.lineWidth = headR * 0.03
    for (const side of [1, -1]) {
      ctx.beginPath()
      ctx.moveTo(q(side * 0.26, L.noseBase + 0.04).x, q(side * 0.26, L.noseBase + 0.04).y)
      ctx.quadraticCurveTo(
        q(side * 0.44, L.mouthY - 0.12).x,
        q(side * 0.44, L.mouthY - 0.12).y,
        q(side * 0.38, L.mouthY + 0.08).x,
        q(side * 0.38, L.mouthY + 0.08).y,
      )
      ctx.stroke()
    }
  }

  ctx.restore()

  // --- ears, outside the face clip because they sit ON the silhouette edge
  ctx.fillStyle = css(shade(skin, 0.3))
  for (const side of [1, -1]) {
    ovalPath(ctx, q(side * L.earX, L.earY), headR * 0.09, headR * 0.17, 0)
    ctx.fill()
  }

  if (plan.beard !== 'none') portraitBeard(ctx, plan, headR, m)

  ctx.restore()
}

/**
 * The whole portrait figure: body from the shared builder, head from this
 * module, lit by the portrait's own bands, with the portrait face on top.
 *
 * `detail` exists so a gate can render the identical transform with and without
 * the face pass and require them to differ. That is the general form of the
 * ART-5 check - a portrait pass that traces without painting fails it - and
 * unlike the old version it duplicates no geometry, so it cannot drift.
 */
export function drawPortraitFigure(
  ctx: CanvasRenderingContext2D,
  plan: FigurePlan,
  rawPose: Skeleton,
  detail = true,
): void {
  const pose = applyBuild(rawPose, plan.build)
  const m = materials(plan.body, plan.trim, plan.gear, plan.beardColor ?? 0x3a2a18, plan.skin)
  paintCel(ctx, figureShapes(plan, pose, m, portraitHeadParts), FIG_W, GROUND, PORTRAIT_BANDS)
  if (detail) drawPortraitFace(ctx, plan, pose, m, headRadius(plan))
}
